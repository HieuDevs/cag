# cp .env.example .env, rồi thay CHANGE_ME.
# Mọi biến đều có giá trị (= mặc định trong app/config.py). Thêm biến vào config thì thêm vào đây.

# ============================================================ OpenRouter
# Bắt buộc: https://openrouter.ai/keys. Dùng cho model trả lời, Jev và embedding.
OPENROUTER_API_KEY=CHANGE_ME
# Tự host: http://vllm:8000/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_NAME="CAG Chinese Tutor"
# allow | deny
OPENROUTER_DATA_COLLECTION=allow
# true khi một tầng dùng Claude/Gemini
PROMPT_CACHE_CONTROL=false
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=5

# ============================================================ Model theo tầng
# JSON, phần tử sau là dự phòng
TIER_SMALL='[{"model":"qwen/qwen3.8-flash","providers":["alibaba"]},{"model":"deepseek/deepseek-v4-flash","providers":[]}]'
TIER_LARGE='[{"model":"qwen/qwen3.7-plus","providers":["alibaba"]},{"model":"deepseek/deepseek-v4-pro","providers":[]}]'
REASONING_INTENTS='["grammar"]'
REASONING_MAX_TOKENS=1024

# ============================================================ Router
# jev | embedding | none
ROUTER_BACKEND=jev
ROUTER_FALLBACK=embedding
JEV_MODEL=typesafe/jev-1.13
JEV_URL=https://openrouter.ai/api/v1/systemone
JEV_TIMEOUT_SECONDS=0.8
JEV_CONFIDENCE_THRESHOLD=0.6
EMBEDDING_CONFIDENCE_THRESHOLD=0.55
NEEDS_CONTEXT_THRESHOLD=0.5

# ============================================================ Embedding + cache câu trả lời gần giống
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_TIMEOUT_SECONDS=3
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_MAX_ENTRIES=50000

# ============================================================ Lưu trữ
# redis://... hoặc memory:// (chỉ cho dev)
REDIS_URL=redis://localhost:6379/0
USAGE_DB_PATH=data/usage.sqlite3
ANSWER_CACHE_TTL_SECONDS=2592000
SESSION_TTL_SECONDS=86400
MAX_TURNS_PER_SESSION=10

# ============================================================ Khác
KNOWLEDGE_DIR=knowledge
WARMUP_ON_STARTUP=false
