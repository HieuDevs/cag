# Sao chép thành .env rồi điền key. Mọi biến đều có giá trị mặc định trong app/config.py.

# --- OpenRouter (bắt buộc) ---
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # đổi sang vLLM tự host: http://vllm:8000/v1
# OPENROUTER_DATA_COLLECTION=deny                    # chỉ dùng nhà cung cấp không lưu dữ liệu để train
# PROMPT_CACHE_CONTROL=false                         # bật khi một tầng dùng Claude/Gemini

# Danh sách model theo tầng (JSON). Phần tử sau là dự phòng. `providers` ghim nhà cung cấp để cache luôn nóng.
# TIER_SMALL=[{"model":"qwen/qwen3.8-flash","providers":["alibaba"]},{"model":"deepseek/deepseek-v4-flash"}]
# TIER_LARGE=[{"model":"qwen/qwen3.7-plus","providers":["alibaba"]},{"model":"deepseek/deepseek-v4-pro"}]
# REASONING_INTENTS=["grammar"]

# --- Router ---
# ROUTER_BACKEND=jev          # jev | embedding | none
# ROUTER_FALLBACK=embedding   # embedding | none
TYPESAFE_API_KEY=
# JEV_CONFIDENCE_THRESHOLD=0.6
# EMBEDDING_MODEL=baai/bge-m3

# --- Lưu trữ ---
# Để trống thì dùng bộ nhớ trong tiến trình (chỉ cho dev, 1 worker).
REDIS_URL=redis://localhost:6379/0
# USAGE_DB_PATH=data/usage.sqlite3

# --- API ---
# Bắt buộc ở production: backend chính gửi `Authorization: Bearer <API_KEY>`.
API_KEY=
# WARMUP_ON_STARTUP=true
